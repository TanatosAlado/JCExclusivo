rules_version = '2';

// =====================================================================
// Reglas de Firestore - JC Exclusivo
//
// Quién puede hacer qué:
//   • Dueño (dueno == true, se marca SOLO desde la consola de Firebase):
//     superadministrador que nadie puede modificar desde la app.
//   • Superadministrador (superAdmin == true): todas las secciones y administra
//     los permisos de los demás administradores (nunca los del dueño, ni se
//     puede quitar su propio superadmin).
//   • Permisos por sección (Clientes/{uid}.permisos): en las colecciones propias
//     de una sección (empresa, marquesina, vouchers, cajeros, sucursales,
//     auditoría) hace falta ese permiso. Si el admin no tiene la lista cargada,
//     se usan los permisos por defecto (ver permisosActuales()).
//   • Administrador (Clientes/{uid}.administrador == true y habilitado): todo,
//     salvo modificar/borrar la auditoría, borrar ventas, gastos o cajas,
//     modificar una caja ya cerrada, modificar/borrar movimientos de caja,
//     modificar un ticket (solo se puede anular, una vez), lo que requiere un
//     permiso de sección que no tiene, y cambiar permisos de usuarios.
//   • Cliente logueado: su propio documento de cliente (sin poder darse
//     permisos de admin / mayorista / habilitado).
//   • Cualquiera (visitante o cliente): ver catálogo y configuración pública,
//     y lo mínimo que necesita el checkout (crear pedido, descontar stock,
//     usar un cupón, avanzar el contador de pedidos).
//   • Todo lo que no está acá abajo: DENEGADO.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones ----------

    function logueado() {
      return request.auth != null;
    }

    function docClienteActual() {
      return get(/databases/$(database)/documents/Clientes/$(request.auth.uid));
    }

    function esAdmin() {
      return logueado()
        && exists(/databases/$(database)/documents/Clientes/$(request.auth.uid))
        && docClienteActual().data.get('administrador', false) == true
        && docClienteActual().data.get('estado', true) != false;
    }

    function esSuperAdmin() {
      return esAdmin()
        && (docClienteActual().data.get('superAdmin', false) == true
          || docClienteActual().data.get('dueno', false) == true);
    }

    // Permisos del admin logueado. Sin lista cargada = por defecto
    // (MISMA lista que PERMISOS_POR_DEFECTO en src/app/core/secciones.ts)
    function permisosActuales() {
      return docClienteActual().data.get('permisos',
        ['despacho', 'clientes', 'productos', 'pedidos', 'taller', 'caja', 'cajeros', 'sucursales', 'tickets']);
    }

    function tienePermiso(seccion) {
      return esSuperAdmin() || (esAdmin() && seccion in permisosActuales());
    }

    // 🌐 "Cotizá tu usado" habilitado por el admin (Gestiones → Tasador)
    function cotizadorPublico() {
      return exists(/databases/$(database)/documents/ConfiguracionTasador/publico)
        && get(/databases/$(database)/documents/ConfiguracionTasador/publico).data.get('habilitado', false) == true;
    }

    // Campos que cambian en un update
    function cambios() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // El campo no cambia (considerando el valor por defecto si no existe)
    function sinCambio(campo, porDefecto) {
      return request.resource.data.get(campo, porDefecto) == resource.data.get(campo, porDefecto);
    }

    // ---------- Administrador ----------
    // Acceso total, con excepciones de trazabilidad:
    //   • Auditoria: solo se puede CREAR (ver más abajo), nunca modificar ni borrar.
    //   • Ventas, gastos y Cajas: no se pueden borrar (se anulan).
    //   • Cajeros: no se borran (se dan de baja: las ventas viejas los siguen nombrando).
    //   • Cajas: una vez CERRADA no se puede modificar (ver más abajo).

    //   • Las colecciones de secciones con permiso y Clientes tienen reglas propias (abajo).

    match /{coleccion}/{document=**} {
      allow read: if esAdmin() && !(coleccion in ['Auditoria']);
      allow create, update: if esAdmin() && !(coleccion in [
        'Auditoria', 'Cajas', 'MovimientosCaja', 'Ventas', 'Clientes',
        'InfoEmpresa', 'infoEmpresa', 'configuracion', 'Marquesina', 'Cupones', 'Cajeros', 'Sucursales',
        'CuentasCorrientes', 'Equipos', 'EquiposIMEI', 'EquiposEliminados', 'Creditos', 'ConfiguracionCreditos'
      ]);
      allow delete: if esAdmin() && !(coleccion in [
        'Auditoria', 'Ventas', 'gastos', 'Cajas', 'MovimientosCaja', 'Cajeros', 'Clientes',
        'InfoEmpresa', 'infoEmpresa', 'configuracion', 'Marquesina', 'Cupones', 'Sucursales',
        'CuentasCorrientes', 'Equipos', 'EquiposIMEI', 'EquiposEliminados', 'CuentasInternas', 'Creditos', 'ConfiguracionCreditos'
      ]);
    }

    // ---------- Secciones con permiso ----------
    match /{coleccion}/{document=**} {
      allow read: if coleccion == 'Auditoria' && tienePermiso('auditoria');
      allow create, update, delete: if
        (coleccion in ['InfoEmpresa', 'infoEmpresa'] && tienePermiso('empresa'))
        || (coleccion == 'Marquesina' && tienePermiso('marquesina'))
        || (coleccion in ['configuracion', 'Cupones'] && tienePermiso('gifts'))
        || (coleccion == 'Sucursales' && tienePermiso('sucursales'));
      // Cajeros: se dan de baja, nunca se borran
      allow create, update: if coleccion == 'Cajeros' && tienePermiso('cajeros');
    }

    // ---------- Clientes (desde el panel) ----------
    // Campos de permisos: administrador, superAdmin, permisos, dueno, y el estado de un admin.
    function sinCambiosDePermisos() {
      return sinCambio('administrador', false)
        && sinCambio('superAdmin', false)
        && sinCambio('permisos', null)
        && sinCambio('dueno', false);
    }

    match /Clientes/{uid} {
      // Administrador común: gestiona clientes, pero NO toca permisos, ni el documento
      // de un superadministrador, ni habilita/deshabilita a otro admin, ni borra admins.
      allow create: if esAdmin()
        && request.resource.data.get('administrador', false) == false
        && request.resource.data.get('superAdmin', false) == false
        && request.resource.data.get('dueno', false) == false
        && !('permisos' in request.resource.data);
      allow update: if esAdmin() && (
        // Despacho / anulación de tickets: sumar o descontar puntos a cualquier cliente
        cambios().hasOnly(['puntos'])
        || (sinCambiosDePermisos()
          && resource.data.get('superAdmin', false) != true
          && resource.data.get('dueno', false) != true
          && (resource.data.get('administrador', false) != true || sinCambio('estado', true))));
      allow delete: if esAdmin()
        && resource.data.get('administrador', false) != true
        && resource.data.get('superAdmin', false) != true
        && resource.data.get('dueno', false) != true;

      // Superadministrador: además da/quita administrador, superAdmin y permisos.
      //  • 'dueno' no se cambia nunca desde la app.
      //  • Al dueño no se le tocan permisos ni estado.
      //  • Nadie se quita su propio superAdmin ni su administrador.
      allow create: if esSuperAdmin() && request.resource.data.get('dueno', false) == false;
      allow update: if esSuperAdmin()
        && sinCambio('dueno', false)
        && (resource.data.get('dueno', false) != true
          || (sinCambiosDePermisos() && sinCambio('estado', true)))
        && (uid != request.auth.uid
          || (sinCambio('superAdmin', false) && sinCambio('administrador', false)));
      allow delete: if esSuperAdmin()
        && resource.data.get('dueno', false) != true
        && uid != request.auth.uid;
    }

    // Cupones (cualquier administrador): en Despacho se usa un cupón (-1) y al anular
    // un ticket se devuelve el uso (+1). Crear o editar cupones requiere el permiso 'gifts'.
    match /Cupones/{id} {
      allow update: if esAdmin()
        && cambios().hasOnly(['cantidadDisponible', 'activo'])
        && (request.resource.data.cantidadDisponible == resource.data.get('cantidadDisponible', 1) - 1
          || request.resource.data.cantidadDisponible == resource.data.get('cantidadDisponible', 0) + 1);
    }

    // ---------- Cajas ----------
    // Se pueden crear y actualizar mientras están abiertas (ventas, cierre).
    // Después del cierre quedan congeladas.
    match /Cajas/{id} {
      allow create: if esAdmin();
      allow update: if esAdmin() && resource.data.get('abierta', true) == true;
    }

    // ---------- Ventas del local (tickets) ----------
    // Se crean con la venta; después solo se pueden ANULAR, una sola vez (o agregarles devoluciones de productos).
    match /Ventas/{id} {
      // "Mi cuenta": cada cliente ve solo sus propios tickets del local
      allow read: if logueado() && resource.data.cliente.id == request.auth.uid;
      allow create: if esAdmin();
      allow update: if esAdmin()
        && resource.data.get('anulada', false) == false
        && request.resource.data.anulada == true
        && cambios().hasOnly(['anulada', 'motivoAnulacion', 'anuladaPor', 'anuladaEn']);
      // ↩ Devolución parcial: al ticket original solo se le agrega / marca la lista de devoluciones
      allow update: if esAdmin()
        && resource.data.get('anulada', false) == false
        && resource.data.get('tipoVenta', '') != 'devolucion'
        && cambios().hasOnly(['devoluciones', 'totalDevuelto'])
        && request.resource.data.devoluciones is list
        && request.resource.data.devoluciones.size() <= 50;
    }

    // ---------- Cuentas corrientes de clientes ----------
    // Las lee cualquier administrador (Despacho, Dashboard, Gestiones).
    // Se escriben al vender a cuenta / cobrar (permiso 'despacho') y al anular tickets ('tickets').
    // Nunca se borran: los movimientos se anulan. El tipo, el importe y el ticket de un movimiento no cambian.
    function puedeOperarCuentas() {
      return tienePermiso('despacho') || tienePermiso('tickets');
    }

    match /CuentasCorrientes/{clienteId} {
      // 📒 Cada cliente puede VER su propia cuenta (Mi cuenta → Cuenta corriente). Solo lectura.
      allow read: if logueado() && request.auth.uid == clienteId;
      allow create, update: if puedeOperarCuentas()
        && request.resource.data.saldo is number
        && request.resource.data.saldo >= -0.01;

      match /Movimientos/{movId} {
        allow read: if logueado() && request.auth.uid == clienteId;
        allow create: if puedeOperarCuentas()
          && request.resource.data.tipo in ['cargo', 'pago']
          && request.resource.data.importe > 0
          && request.resource.data.ventaId == movId
          && request.resource.data.anulado == false;
        allow update: if puedeOperarCuentas()
          && sinCambio('tipo', null)
          && sinCambio('importe', null)
          && sinCambio('ventaId', null)
          && sinCambio('nroTicket', null)
          && sinCambio('fecha', null)
          && resource.data.get('anulado', false) == false;
      }
    }

    // ---------- 🏠 Crédito de la casa ----------
    // Los lee cualquier administrador. Se crean con la venta en Despacho (siempre 'vigente', sin pagos,
    // de 1 a 24 cuotas). Después cambian al cobrar cuotas (Despacho) o al anular (Tickets / Cuentas):
    // lo financiado, el cliente, la venta y las cuotas pactadas no cambian. Nunca se borran.
    match /Creditos/{ventaId} {
      // 🏠 Cada cliente puede VER sus propios créditos (Mi cuenta → Estado de los créditos). Solo lectura.
      allow read: if logueado() && resource.data.cliente.id == request.auth.uid;
      allow create: if tienePermiso('despacho')
        && request.resource.data.ventaId == ventaId
        && request.resource.data.estado == 'vigente'
        && request.resource.data.importe is number
        && request.resource.data.importe > 0
        && request.resource.data.saldo == request.resource.data.importe
        && request.resource.data.pagado == 0
        && request.resource.data.cantidadCuotas is int
        && request.resource.data.cantidadCuotas >= 1
        && request.resource.data.cantidadCuotas <= 24
        && request.resource.data.cuotas.size() == request.resource.data.cantidadCuotas
        && request.resource.data.cliente.id is string;
      // Crédito dado antes del sistema, cargado a mano en Gestiones → Créditos (sin venta ni ticket)
      allow create: if tienePermiso('cuentas')
        && request.resource.data.get('origen', '') == 'manual'
        && request.resource.data.ventaId == ventaId
        && request.resource.data.nroTicket == null
        && request.resource.data.estado == 'vigente'
        && request.resource.data.importe is number
        && request.resource.data.importe > 0
        && request.resource.data.saldo == request.resource.data.importe
        && request.resource.data.pagado == 0
        && request.resource.data.cantidadCuotas is int
        && request.resource.data.cantidadCuotas >= 1
        && request.resource.data.cantidadCuotas <= 60
        && request.resource.data.cuotas.size() == request.resource.data.cantidadCuotas
        && request.resource.data.cliente.id is string
        && request.resource.data.cliente.nombre is string
        && request.resource.data.cliente.nombre.size() > 0;
      allow update: if (tienePermiso('despacho') || tienePermiso('tickets') || tienePermiso('cuentas'))
        && resource.data.estado != 'anulado'
        && request.resource.data.estado in ['vigente', 'cancelado', 'anulado', 'refinanciado']
        && sinCambio('importe', null)
        && sinCambio('ventaId', null)
        && sinCambio('cliente', null)
        && sinCambio('cantidadCuotas', null)
        && sinCambio('fecha', null)
        && request.resource.data.saldo is number
        && request.resource.data.saldo >= -0.01
        && request.resource.data.saldo <= resource.data.importe + 0.01;
      // ✏️ Corrección de un crédito cargado a mano: solo superadministradores
      allow update: if esSuperAdmin()
        && resource.data.get('origen', '') == 'manual'
        && sinCambio('origen', '')
        && sinCambio('ventaId', null)
        && resource.data.estado in ['vigente', 'cancelado']
        && request.resource.data.estado in ['vigente', 'cancelado']
        && request.resource.data.cantidadCuotas is int
        && request.resource.data.cantidadCuotas >= 1
        && request.resource.data.cantidadCuotas <= 60
        && request.resource.data.cuotas.size() == request.resource.data.cantidadCuotas
        && request.resource.data.importe is number
        && request.resource.data.importe > 0
        && request.resource.data.saldo >= -0.01
        && request.resource.data.saldo <= request.resource.data.importe + 0.01;

      // Pagos de cuotas (se crean al cobrar en Despacho o, los viejos, a mano; después solo se pueden anular)
      match /Pagos/{pagoId} {
        allow read: if logueado()
          && get(/databases/$(database)/documents/Creditos/$(ventaId)).data.cliente.id == request.auth.uid;
        allow create: if tienePermiso('despacho')
          && request.resource.data.importe > 0
          && request.resource.data.anulado == false;
        // Pagos viejos (de antes del sistema) de un crédito cargado a mano: sin ticket ni caja
        allow create: if tienePermiso('cuentas')
          && request.resource.data.get('anterior', false) == true
          && request.resource.data.importe > 0
          && request.resource.data.anulado == false
          && get(/databases/$(database)/documents/Creditos/$(ventaId)).data.get('origen', '') == 'manual';
        allow update: if (tienePermiso('despacho') || tienePermiso('tickets') || tienePermiso('cuentas'))
          && sinCambio('importe', null)
          && sinCambio('fecha', null)
          && resource.data.get('anulado', false) == false;
      }
    }

    // 🧮 Tasador de equipos usados: lo lee cualquier administrador (Despacho tasa el plan canje),
    // lo cambia quien tiene el permiso Tasador.
    match /Tasador/{id} {
      // Clientes ("Cotizá tu usado"): solo los modelos activos y solo si el admin lo habilitó
      allow read: if esAdmin() || (resource.data.get('activo', false) == true && cotizadorPublico());
      allow create, update: if tienePermiso('tasador')
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 1
        && request.resource.data.capacidades is list
        && request.resource.data.capacidades.size() >= 1
        && request.resource.data.capacidades.size() <= 10
        && request.resource.data.preguntas is list
        && request.resource.data.preguntas.size() <= 60;
      allow delete: if tienePermiso('tasador');
    }
    // Historial de tasaciones (no se modifican)
    match /Tasaciones/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.totalUSD is number
        && request.resource.data.modelo is string;
      // Cotización de un cliente en la web (solo si está habilitado; sin datos personales)
      allow create: if cotizadorPublico()
        && request.resource.data.origen == 'web'
        && request.resource.data.usuario == null
        && request.resource.data.totalUSD is number
        && request.resource.data.modelo is string
        && request.resource.data.modelo.size() <= 80
        && request.resource.data.respuestas is list
        && request.resource.data.respuestas.size() <= 60
        && request.resource.data.keys().hasOnly(['modeloId', 'modelo', 'capacidad', 'precioBase', 'respuestas', 'descuentos',
             'totalUSD', 'cotizacion', 'totalARS', 'fecha', 'origen', 'usuario', 'cajero']);
    }
    // Interruptor de "Cotizá tu usado" (lo lee cualquiera; lo cambia el permiso Tasador)
    match /ConfiguracionTasador/{id} {
      allow read: if true;
      allow create, update: if tienePermiso('tasador') && id == 'publico' && request.resource.data.habilitado is bool;
    }

    // Planes de cuotas e interés del crédito de la casa (los lee cualquier administrador, p. ej. Despacho).
    // Los cambia el permiso de Cuentas corrientes / Créditos. No se borran.
    match /ConfiguracionCreditos/{id} {
      allow create, update: if tienePermiso('cuentas')
        && id == 'planes'
        && request.resource.data.planes is list
        && request.resource.data.planes.size() >= 1
        && request.resource.data.planes.size() <= 24;
    }

    // ---------- Equipos para la venta ----------
    // Los lee cualquier administrador. Alta, modificación y baja: permiso 'equipos'.
    //   • Se crean como 'disponible'. Por PLAN CANJE (Despacho) entran 'preparacion' (sin precios),
    //     junto con su venta; se publican (→ 'disponible') desde Gestiones → Equipos.
    //   • Un equipo vendido no se modifica ni se borra (queda para la garantía).
    //   • La baja guarda una copia en EquiposEliminados (que no se modifica ni se borra).
    //   • EquiposIMEI: índice para que no se repita el IMEI entre equipos disponibles.
    match /Equipos/{id} {
      allow create: if tienePermiso('equipos')
        && request.resource.data.estado == 'disponible'
        && request.resource.data.imei is string
        && request.resource.data.imei.size() >= 5
        && request.resource.data.precioMinorista > 0
        && request.resource.data.precioMayorista > 0
        && request.resource.data.moneda in ['USD', 'ARS'];
      allow update: if tienePermiso('equipos')
        && resource.data.estado in ['disponible', 'preparacion']
        && request.resource.data.estado in ['disponible', 'preparacion']
        && !(resource.data.estado == 'disponible' && request.resource.data.estado == 'preparacion')
        && (request.resource.data.estado == 'preparacion'
          || (request.resource.data.precioMinorista > 0 && request.resource.data.precioMayorista > 0))
        && request.resource.data.moneda in ['USD', 'ARS'];
      allow delete: if tienePermiso('equipos') && resource.data.estado in ['disponible', 'preparacion'];

      // 📲 Plan canje: el equipo usado entra en preparación, en la misma operación que su venta
      allow create: if tienePermiso('despacho')
        && request.resource.data.estado == 'preparacion'
        && request.resource.data.imei is string
        && request.resource.data.imei.size() >= 5
        && request.resource.data.canje.ventaId is string
        && existsAfter(/databases/$(database)/documents/Ventas/$(request.resource.data.canje.ventaId));
      // …y si se anula esa venta, se da de baja (se le devuelve al cliente), si no se vendió
      allow delete: if (tienePermiso('tickets') || tienePermiso('despacho') || tienePermiso('cuentas'))
        && resource.data.estado in ['disponible', 'preparacion']
        && resource.data.canje.ventaId is string
        && getAfter(/databases/$(database)/documents/Ventas/$(resource.data.canje.ventaId)).data.anulada == true;

      // Venta en Despacho (disponible → vendido), anulación del ticket o cancelación del pedido web (vendido → disponible)
      // (cuentas: anular un crédito de la casa desde Gestiones → Créditos devuelve el equipo al stock)
      allow update: if (tienePermiso('despacho') || tienePermiso('tickets') || tienePermiso('pedidos') || tienePermiso('cuentas'))
        && cambios().hasOnly(['estado', 'venta', 'ventasAnuladas'])
        && (
          (resource.data.estado == 'disponible' && request.resource.data.estado == 'vendido'
            && request.resource.data.venta.ventaId is string)
          ||
          (resource.data.estado == 'vendido' && request.resource.data.estado == 'disponible')
        );
    }

    match /EquiposIMEI/{imei} {
      allow create, update, delete: if tienePermiso('equipos');
      // Al vender se libera el IMEI; al anular la venta / cancelar el pedido se vuelve a ocupar
      allow create, update, delete: if tienePermiso('despacho') || tienePermiso('tickets') || tienePermiso('pedidos') || tienePermiso('cuentas');
      // Tienda: al comprar el equipo se libera su IMEI (solo si en la misma operación quedó vendido)
      allow delete: if getAfter(/databases/$(database)/documents/Equipos/$(resource.data.equipoId)).data.estado == 'vendido';
    }

    // Tienda online: cualquiera ve los equipos DISPONIBLES (la consulta tiene que filtrar estado == 'disponible')
    // y al hacer el pedido el equipo pasa a vendido, solo si en la misma operación se crea ese pedido.
    match /Equipos/{id} {
      allow read: if resource.data.estado == 'disponible';
      allow update: if resource.data.estado == 'disponible'
        && request.resource.data.estado == 'vendido'
        && cambios().hasOnly(['estado', 'venta'])
        && request.resource.data.venta.origen == 'web'
        && request.resource.data.venta.pedidoId is string
        && existsAfter(/databases/$(database)/documents/$('Pedidos Pendientes')/$(request.resource.data.venta.pedidoId));
    }

    match /EquiposEliminados/{id} {
      allow create: if tienePermiso('equipos');
      // Equipo del plan canje dado de baja al anular su venta
      allow create: if (tienePermiso('tickets') || tienePermiso('despacho') || tienePermiso('cuentas'))
        && request.resource.data.canje.ventaId is string
        && getAfter(/databases/$(database)/documents/Ventas/$(request.resource.data.canje.ventaId)).data.anulada == true;
    }

    // ---------- Movimientos de caja ----------
    // Se crean y se anulan solo con la caja ABIERTA, nunca se modifican ni se borran.
    function cajaAbierta(cajaId) {
      return get(/databases/$(database)/documents/Cajas/$(cajaId)).data.get('abierta', true) == true;
    }

    match /MovimientosCaja/{id} {
      allow create: if esAdmin()
        && request.resource.data.usuario.uid == request.auth.uid
        && request.resource.data.importe > 0
        && request.resource.data.anulado == false
        && cajaAbierta(request.resource.data.cajaId);

      // Anular (una sola vez) o marcar la corrección que lo reemplaza
      allow update: if esAdmin()
        && cajaAbierta(resource.data.cajaId)
        && (
          (cambios().hasOnly(['anulado', 'motivoAnulacion', 'anuladoPor', 'anuladoEn'])
            && resource.data.get('anulado', false) == false
            && request.resource.data.anulado == true)
          ||
          (cambios().hasOnly(['corregidoPor'])
            && resource.data.get('corregidoPor', null) == null)
        );
    }

    // ---------- Auditoría ----------
    // Cada registro debe ser del usuario que está logueado y con la hora del servidor.
    // La ve quien tiene el permiso 'auditoria' (regla de arriba).
    match /Auditoria/{id} {
      allow create: if esAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.fecha == request.time;
    }

    // ---------- Catálogo y configuración pública ----------

    match /productos/{id} {
      allow read: if true;
      // Checkout (visitantes y clientes): solo pueden modificar el stock
      allow update: if cambios().hasOnly(['stockSucursales', 'stockMayorista', 'variantes']);
    }

    match /Sucursales/{id}    { allow read: if true; }
    match /Marquesina/{id}    { allow read: if true; }
    match /InfoEmpresa/{id}   { allow read: if true; }
    match /infoEmpresa/{id}   { allow read: if true; }
    match /configuracion/{id} { allow read: if true; }

    // ---------- Clientes ----------

    // Solicitud de cuenta mayorista que puede hacer el propio cliente: solo 'pendiente',
    // con sus datos y nada de lo que completa el administrador al resolverla.
    function solicitudMayoristaPropiaValida(s) {
      return s.keys().hasOnly(['estado', 'fecha', 'razonSocial', 'cuit'])
        && s.estado == 'pendiente'
        && s.razonSocial is string && s.razonSocial.size() > 0 && s.razonSocial.size() <= 120
        && s.cuit is string && s.cuit.matches('^[0-9]{11}$')
        && s.fecha is string;
    }

    match /Clientes/{uid} {
      // Cada cliente lee solo su propio documento
      allow get: if logueado() && request.auth.uid == uid;

      // Registro: solo su propio documento y sin privilegios
      allow create: if logueado() && request.auth.uid == uid
        && request.resource.data.get('administrador', false) == false
        && request.resource.data.get('superAdmin', false) == false
        && request.resource.data.get('dueno', false) == false
        && !('permisos' in request.resource.data)
        && request.resource.data.get('estado', true) == true
        && request.resource.data.get('puntos', 0) == 0
        && request.resource.data.get('mayoristaActivado', false) == false
        // Nadie se registra directamente como mayorista: lo aprueba un administrador
        && request.resource.data.get('esMayorista', false) == false
        && (!('solicitudMayorista' in request.resource.data)
            || solicitudMayoristaPropiaValida(request.resource.data.solicitudMayorista));

      // Carrito, historial, puntos, datos de contacto... pero NO permisos
      allow update: if logueado() && request.auth.uid == uid
        && sinCambio('administrador', false)
        && sinCambio('superAdmin', false)
        && sinCambio('dueno', false)
        && sinCambio('permisos', null)
        && sinCambio('esMayorista', false)
        && sinCambio('estado', true)
        && sinCambio('usuario', '')
        // Solicitud mayorista: solo puede PEDIRLA (si no es mayorista y no tiene una pendiente);
        // aprobarla o rechazarla es cosa del administrador
        && (sinCambio('solicitudMayorista', null)
            || (resource.data.get('esMayorista', false) == false
                && resource.data.get('solicitudMayorista', {'estado': ''}).estado != 'pendiente'
                && solicitudMayoristaPropiaValida(request.resource.data.solicitudMayorista)));
    }

    // Índice nombre de usuario → mail (lo usa el login)
    match /Usuarios/{usuario} {
      allow get: if true;
      allow create: if logueado()
        && request.resource.data.keys().hasOnly(['uid', 'mail'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mail == request.auth.token.email;
    }

    // ---------- Cupones ----------

    match /Cupones/{id} {
      // Se buscan por código desde el checkout
      allow read: if true;
      // Checkout: solo descontar un uso (y desactivarlo si se agotó)
      allow update: if cambios().hasOnly(['cantidadDisponible', 'activo'])
        && request.resource.data.cantidadDisponible == resource.data.get('cantidadDisponible', 1) - 1
        && (!('activo' in cambios()) || request.resource.data.activo == false);
    }

    // ---------- Colecciones con espacios en el nombre ----------

    match /{coleccion}/{id} {
      // Consulta pública del estado de una reparación (link/QR con el id de la orden)
      allow get: if coleccion in ['Ordenes Pendientes', 'Ordenes Finalizadas'];

      // Número de pedido: se lee y se avanza de a 1
      allow read: if coleccion == 'Contador Pedidos';
      allow update: if coleccion == 'Contador Pedidos'
        && cambios().hasOnly(['contador'])
        && request.resource.data.contador == resource.data.contador + 1;

      // "Mi cuenta": cada cliente ve solo sus propios pedidos web (con su estado)
      allow read: if coleccion in ['Pedidos Pendientes', 'Pedidos Finalizados', 'Pedidos Eliminados']
        && logueado() && resource.data.clienteId == request.auth.uid;

      // Checkout: crear el pedido
      allow create: if coleccion == 'Pedidos Pendientes'
        && request.resource.data.estado == 'pendiente';
    }
  }
}
